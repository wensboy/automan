{
    "meta": {
        "namespace": "conf/bridge"
    },
    "node": {
        "enable": true,
        "sock": "bridge/node.sock",
        "codec": "json",
        "maxMessageBytes": 4194304,
        "handshakeTimeoutMs": 5000,
        "heartbeatMs": 15000,
        "heartbeatGraceMs": 5000,
        "token": "",
        "restart": "none",
        "restartMax": 32,
        "command": "",
        "args": [],
        "dir": "",
        "env": [
            "WHISTLE_BIN=${AUTOMAN_ROOT}/backend/bridge/node/node_modules/whistle/bin/whistle.js"
        ],
        "services": {
            "proxy": {
                "root": "proxies/",
                "stopTimeoutMs": 5000
            },
            "automation": {}
        }
    }
}
