{
  "name": "automan-node-core",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Automan Node Core - node运行时核心",
  "scripts": {
    "build": "node esbuild.config.ts && node scripts/copy-runtime.mjs",
