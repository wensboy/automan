{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://automan.local/schema/settings.user.schema.json",
    "title": "Automan user settings",
    "description": "settings.user.json 的 schema. 与 data/default/settings.user.json 保持同步, **以后者为准**; 用户文件只写覆盖项, 未写入的键回落到默认层与 runtime 层.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "指向本 schema 的相对路径 (供编辑器识别)."
        },
        "appearence": {
            "type": "object",
            "description": "外观与布局.",
            "properties": {
                "mode": {
                    "enum": [
                        "auto",
                        "light",
                        "dark"
                    ],
                    "default": "auto",
                    "description": "主题模式: auto 跟随系统."
                },
                "compact": {
                    "type": "boolean",
                    "default": false,
                    "description": "紧凑布局: 压缩行高与间距."
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "description": "主题细节.",
            "properties": {
                "accent": {
                    "enum": [
                        "neutral",
                        "blue",
                        "green",
                        "orange"
                    ],
                    "default": "neutral",
                    "description": "强调色 (与 index.css 的 token 对应)."
                },
                "radius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 0.625,
                    "description": "圆角系数 (rem)."
                }
            },
            "additionalProperties": false
        },
        "proxy": {
            "type": "object",
            "description": "代理默认行为.",
            "properties": {
                "autoStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "应用启动时自动启动代理."
                },
                "timeout": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 30,
                    "description": "上游超时 (秒)."
                },
                "bypass": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "localhost",
                        "127.0.0.1"
                    ],
                    "description": "绕过代理的主机列表."
                },
                "userAgent": {
                    "type": "string",
                    "default": "",
                    "description": "覆盖发送的 User-Agent (空表示不覆盖)."
                }
            },
            "additionalProperties": false
        },
        "automation": {
            "type": "object",
            "description": "自动化默认行为.",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "是否启用自动化."
                },
                "concurrency": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 32,
                    "default": 4,
                    "description": "并发上限."
                },
                "paths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "自动化脚本搜索目录."
                }
            },
            "additionalProperties": false
        },
        "general": {
            "type": "object",
            "description": "通用.",
            "properties": {
                "language": {
                    "enum": [
                        "English",
                        "Chinese"
                    ],
                    "default": "English",
                    "description": "界面语言."
                },
                "startupPage": {
                    "type": "string",
                    "default": "/",
                    "description": "启动后打开的页面."
                },
                "session": {
                    "type": "object",
                    "description": "会话.",
                    "properties": {
                        "expirationS": {
                            "type": "number",
                            "minimum": 60,
                            "maximum": 604800,
                            "default": 7200,
                            "description": "登录态有效期 (秒); 应用重启时按\"最后登录时间 + 有效期\"判断是否仍然有效."
                        },
                        "resumeOnStart": {
                            "type": "boolean",
                            "default": true,
                            "description": "应用启动时是否按登录日志恢复上次会话(关闭则每次启动都要登录)."
                        },
                        "slidingExpire": {
                            "type": "boolean",
                            "default": true,
                            "description": "是否滑动续期: 每次校验都会延长会话有效期; 关闭则从登录时刻起绝对到期."
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "advanced": {
            "type": "object",
            "description": "高级 (程序参数).",
            "properties": {
                "watchMs": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 60000,
                    "default": 2000,
                    "description": "用户文件轮询间隔 (毫秒)."
                },
                "debounceMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000,
                    "default": 100,
                    "description": "外部改动的去抖窗口 (毫秒)."
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
