{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://automan.local/schema/settings.user.schema.json",
    "title": "Automan user settings",
    "description": "settings.user.json 的 schema. 与 data/default/settings.user.json 保持同步, **以后者为准**; 用户文件只写覆盖项, 未写入的键回落到默认层与 runtime 层.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string",
            "description": "指向本 schema 的相对路径 (供编辑器识别)."
        },
        "appearence": {
            "type": "object",
            "description": "外观.",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "light",
                        "dark"
                    ],
                    "default": "auto"
                }
            },
            "additionalProperties": false
        },
        "theme": {
            "type": "object",
            "description": "主题.",
            "properties": {
                "current": {
                    "type": "string",
                    "default": "default",
                    "description": "当前主题 id; 可选值来自 theme.register 指向的 theme.json(动态 options)."
                },
                "register": {
                    "type": "string",
                    "default": "~/.config/automan/theme.json",
                    "description": "主题文件路径; 启动时会把默认 theme.json 同步到用户目录."
                }
            },
            "additionalProperties": false
        },
        "proxy": {
            "type": "object",
            "description": "代理相关上限与超时(由 service/proxy 按语义执行).",
            "properties": {
                "maxCountLimit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096,
                    "default": 64,
                    "description": "单工作区可创建的代理数量上限."
                },
                "maxStartLimit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256,
                    "default": 8,
                    "description": "一次批量启动允许的最大条数."
                },
                "maxRunningLimit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256,
                    "default": 8,
                    "description": "单工作区同时运行的最大实例数."
                },
                "timeout": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 300000,
                    "default": 32000,
                    "description": "单个实例启动等待上限(毫秒)."
                }
            },
            "additionalProperties": false
        },
        "automation": {
            "type": "object",
            "description": "自动化(预留).",
            "additionalProperties": true
        },
        "general": {
            "type": "object",
            "description": "通用.",
            "properties": {
                "language": {
                    "enum": [
                        "English",
                        "Chinese"
                    ],
                    "default": "English",
                    "description": "界面语言."
                },
                "startupPage": {
                    "type": "string",
                    "default": "/",
                    "description": "启动后打开的页面."
                },
                "session": {
                    "type": "object",
                    "description": "会话.",
                    "properties": {
                        "expirationS": {
                            "type": "number",
                            "minimum": 60,
                            "maximum": 604800,
                            "default": 7200,
                            "description": "登录态有效期 (秒); 应用重启时按\"最后登录时间 + 有效期\"判断是否仍然有效."
                        },
                        "resumeOnStart": {
                            "type": "boolean",
                            "default": true,
                            "description": "应用启动时是否按登录日志恢复上次会话(关闭则每次启动都要登录)."
                        },
                        "slidingExpire": {
                            "type": "boolean",
                            "default": true,
                            "description": "是否滑动续期: 每次校验都会延长会话有效期; 关闭则从登录时刻起绝对到期."
                        }
                    },
                    "additionalProperties": false
                },
                "workspace": {
                    "type": "object",
                    "description": "工作区.",
                    "properties": {
                        "limit": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 1024,
                            "default": 32,
                            "description": "单个用户可创建的工作区数量上限; 超出后创建会被拒绝."
                        }
                    }
                },
                "notice": {
                    "type": "object",
                    "description": "通知(notification)相关设置.",
                    "properties": {
                        "doNotDisturb": {
                            "type": "boolean",
                            "default": false,
                            "description": "勿扰模式: 开启后业务提示不再入队, 也不弹 toast."
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "advanced": {
            "type": "object",
            "description": "高级项(预留).",
            "additionalProperties": true
        }
    },
    "additionalProperties": false
}
