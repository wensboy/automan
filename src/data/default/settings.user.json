{
    "appearence": {
        "mode": "auto",
        "compact": false
    },
    "theme": {
        "current": "default",
        "register": "~/.config/automan/theme.json"
    },
    "proxy": {
        "autoStart": false,
        "timeout": 30,
        "bypass": [
            "localhost",
            "127.0.0.1"
        ],
        "userAgent": ""
    },
    "automation": {
        "enabled": false,
        "concurrency": 4,
        "paths": []
    },
    "general": {
        "language": "English",
        "startupPage": "/",
        "session": {
            "expirationS": 7200,
            "resumeOnStart": true,
            "slidingExpire": true
        },
        "workspace": {
            "limit": 32
        },
        "notice": {
            "doNotDisturb": false
        }
    },
    "advanced": {
        "watchMs": 2000,
        "debounceMs": 100
    }
}
